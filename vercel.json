{
  "crons": [
    {
      "path": "/api/ghost-resolve",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/brain-report",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/weekly-digest",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/snapshot-cron?window=open",
      "schedule": "35 14 * * 1-5"
    },
    {
      "path": "/api/snapshot-cron?window=mid",
      "schedule": "0 18 * * 1-5"
    },
    {
      "path": "/api/snapshot-cron?window=close",
      "schedule": "5 20 * * 1-5"
    },
    {
      "path": "/api/daily-data-cron?phase=hv",
      "schedule": "5 22 * * 1-5"
    },
    {
      "path": "/api/daily-data-cron?phase=calibration",
      "schedule": "15 22 * * 1-5"
    },
    {
      "path": "/api/market-intelligence-cron",
      "schedule": "* 13-21 * * 1-5"
    },
    {
      "path": "/api/health-check-cron",
      "schedule": "0 13 * * 1-5"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
